# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=NevUp Trading Psychology Coach
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/nevup.db

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=nevup-hackathon-secret-2026-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM Provider (openai | groq | ollama) ────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (alternative)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# Ollama (local, no key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3

# ── Dataset ───────────────────────────────────────────────────────────────────
DATASET_PATH=./nevup_seed_dataset.json

# ── Behaviour Detection Thresholds ────────────────────────────────────────────
REVENGE_WINDOW_SECONDS=90
OVERTRADING_WINDOW_MINUTES=30
OVERTRADING_THRESHOLD=10
SESSION_TILT_LOSS_RATIO=0.6
FOMO_PLAN_ADHERENCE_MAX=2
LOSS_RUNNING_PNL_THRESHOLD=-200.0
PREMATURE_EXIT_RATIO=0.5
POSITION_SIZING_CV_THRESHOLD=0.5
